    "/create_proposal": {
      "post": {
        "summary": "[write] create_proposal",
        "tags": [
          "Service Operations"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ToolsService.optisell_api_Proposal"
                    }
                  ],
                  "nullable": true
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/error"
          }
        },
        "requestBody": {
          "description": "Action parameters",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "store_id": {
                    "type": "string"
                  },
                  "sku": {
                    "type": "string"
                  },
                  "batch": {
                    "type": "string"
                  },
                  "old_price": {
                    "type": "number",
                    "format": "double"
                  },
                  "new_price": {
                    "type": "number",
                    "format": "double"
                  },
                  "discount_pct": {
                    "type": "number",
                    "format": "double"
                  },
                  "margin_pct": {
                    "type": "number",
                    "format": "double"
                  },
                  "margin_breach": {
                    "type": "boolean"
                  },
                  "at_risk_qty": {
                    "type": "number",
                    "format": "double"
                  },
                  "reason": {
                    "type": "string"
                  },
                  "requested_by": {
                    "type": "string",
                    "nullable": true
                  }
                },
                "required": [
                  "store_id",
                  "sku",
                  "batch",
                  "old_price",
                  "new_price",
                  "discount_pct",
                  "margin_pct",
                  "margin_breach",
                  "at_risk_qty",
                  "reason"
                ]
              }
            }
          }
        },
        "operationId": "create_proposal",
        "x-read-only": false,
        "description": "Write. Creates a price-change request and starts the SBPA approval process.\nThe price is NOT changed here — only after SBPA approves. 409 if the batch already has an approval in progress."
      }
    },
